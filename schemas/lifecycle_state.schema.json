{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Robin9989Law/research-harness/schemas/lifecycle_state.schema.json",
  "title": "Research lifecycle state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "active_stage", "stage_pointers"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "active_stage": {
      "enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6"]
    },
    "stage_pointers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["E0", "E1", "E2", "E3", "E4", "E5", "E6"],
      "properties": {
        "E0": { "const": "workflow_state.json#output_type" },
        "E1": { "const": null },
        "E2": { "const": "workflow_state.json" },
        "E3": { "const": "workflow_state.json" },
        "E4": { "const": "workflow_state.json#compute_stage" },
        "E5": { "const": null },
        "E6": { "const": null }
      }
    }
  }
}
